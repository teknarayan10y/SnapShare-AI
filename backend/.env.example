PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/snapshare
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500
MAX_COLLECTION_ZIP_MB=2048

# Cloudinary Image Storage Configuration (Sign up free at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Google Gemini Vision API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

